# App settings. Copy to app.production.env on the VPS and keep private.
# Use the same MYSQL_PASSWORD as .env.production. URL-encode special characters.
DATABASE_URL=mysql://fluentlearner:replace-with-a-long-hex-password@db:3306/fluentlearner
JWT_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters
PUBLIC_SITE_URL=https://example.com
