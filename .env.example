DATABASE_URL=mysql://user:password@127.0.0.1:3306/fluentlearner
JWT_SECRET=replace-with-a-long-random-secret

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=Administrator

# Local database-backed student account created by `npm run seed:student`
STUDENT_EMAIL=student@localhost.test
STUDENT_PASSWORD=student12345
STUDENT_NAME=Local Student
STUDENT_TARGET_BAND=7.0

# Development-only login (disabled automatically in production)
LOCAL_ADMIN_EMAIL=admin@localhost.test
LOCAL_ADMIN_PASSWORD=admin12345
LOCAL_ADMIN_NAME=Local Administrator

# Optional standalone integrations
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NOTIFICATION_WEBHOOK_URL=
UPLOAD_DIR=client/public/uploads
PUBLIC_UPLOAD_URL=/uploads

# bKash Tokenized Checkout (v2 enroll page). Leave blank to hide online payment.
# Sandbox: https://tokenized.sandbox.bka.sh/v1.2.0-beta   Live: https://tokenized.pay.bka.sh/v1.2.0-beta
BKASH_BASE_URL=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_APP_KEY=
BKASH_APP_SECRET=
# Nagad, Rocket and cards through SSLCommerz (optional; usually set in Admin → Settings → Online payment)
SSLCOMMERZ_MODE=sandbox
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
# Public site address used for the bKash return URL (needed behind a proxy), e.g. https://fluentlearner.com.bd
PUBLIC_SITE_URL=

# AI marking of Writing & Speaking (Claude). Leave blank to keep manual mentor marking only.
ANTHROPIC_API_KEY=
